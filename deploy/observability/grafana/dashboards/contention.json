  {
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "",
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 20
   },
   "id": 24,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le, buckets) (rate(ledger_hot_bucket_lock_seconds_bucket{run_id=~\"$run_id\",scenario=~\"$scenario\"}[1m])))",
     "legendFormat": "N={{buckets}}",
     "refId": "A"
    }
   ],
   "title": "Hot-bucket lock wait by N",
   "type": "timeseries"
  }
 ],
 "refresh": "10s",
 "schemaVersion": 39,
 "tags": [
  "payflow"
 ],
 "templating": {
  "list": [
   {
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "includeAll": true,
    "label": "run_id",
    "multi": true,
    "name": "run_id",
    "query": {
     "query": "label_values(ledger_transfers_total, run_id)",
     "refId": "run_id"
    },
    "refresh": 2,
    "type": "query"
   },
   {
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "includeAll": true,
    "label": "scenario",
    "multi": true,
    "name": "scenario",
    "query": {
     "query": "label_values(ledger_transfers_total, scenario)",
     "refId": "scenario"
    },
    "refresh": 2,
    "type": "query"
   },
   {
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "includeAll": true,
    "label": "strategy",
    "multi": true,
    "name": "strategy",
    "query": {
     "query": "label_values(ledger_transfers_total, strategy)",
     "refId": "strategy"
    },
    "refresh": 2,
    "type": "query"
   }
  ]
 },
